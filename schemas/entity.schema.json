{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org-brain.dev/schemas/entity.schema.json",
  "title": "Entity",
  "type": "object",
  "required": [
    "id",
    "organization_id",
    "type",
    "name",
    "canonical_key",
    "schema_version"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "canonical_key": {
      "type": "string"
    },
    "attributes": {
      "type": "object"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "stale",
        "deleted"
      ]
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "type": "string"
    }
  }
}
