# Database (required for bootstrap/serve)
ORG_BRAIN_DATABASE_URL=postgresql+psycopg://orgbrain:orgbrain@localhost:5432/orgbrain

# Path to organization KB instance created by `org-brain init`
ORG_BRAIN_INSTANCE=./my-org-kb

# Optional model provider (leave unset for retrieval-only answers)
ORG_BRAIN_MODEL_PROVIDER=
ORG_BRAIN_EXTRACTION_MODEL=
ORG_BRAIN_ANSWER_MODEL=
ORG_BRAIN_API_KEY=

# Server
ORG_BRAIN_HOST=0.0.0.0
ORG_BRAIN_PORT=8000
ORG_BRAIN_LOG_LEVEL=info

# Auth (Phase 8). Empty = local trust header for demos only.
ORG_BRAIN_AUTH_MODE=dev
ORG_BRAIN_DEV_ORG_ID=example-org
ORG_BRAIN_DEV_USER_ID=dev-user
